# 학원 관리 — 환경 변수 (예시)
# 복사: cp .env.example .env

# mock | live — 로컬 목업이면 mock (OAuth/Better Auth 경로 없이 고정 테스트 사용자).
# mock 이어도 업무 데이터는 MongoDB 필수(세션만 우회). 데모는 DB 가동 + seed 권장.
AUTH_MODE=mock

# MongoDB (mongoose + Better Auth 어댑터)
DB_URL=mongodb://127.0.0.1:27017/academy

# AUTH_MODE=live 일 때 필수
BETTER_AUTH_SECRET=
# 앱이 외부에 노출되는 원본 URL (OAuth 리다이렉트·쿠키)
BETTER_AUTH_URL=http://localhost:5173

# 브라우저용 Better Auth 클라이언트 베이스 URL (비우면 현재 origin)
PUBLIC_BETTER_AUTH_URL=http://localhost:5173

# AUTH_MODE=live 일 때 소셜 OAuth (카카오·네이버·구글). ID·Secret 쌍이 모두 있을 때만 해당 버튼 노출.
# 각 제공자 개발자 콘솔 Redirect URI 예: {BETTER_AUTH_URL}/api/auth/callback/kakao (naver·google 동일 패턴)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 선택: 학부모 포털 영수증에 표시할 학원 표시명 (비우면 "학원")
PUBLIC_ACADEMY_DISPLAY_NAME=

# 로컬 기본 학원(ObjectId hex). 시드 기본값과 맞출 것.
DEV_ACADEMY_ID=507f1f77bcf86cd799439011
# 데모용 둘째 학원(분원). 시드가 `testuser`·`superadmin` 멤버십을 넣어 다학원 전환 UI를 바로 시연할 수 있게 함. 비우면 기본 507f1f77bcf86cd799439022.
# DEV_ACADEMY_SECOND_ID=507f1f77bcf86cd799439022
# 목업: `npm run seed` 가 멤버십·샘플 데이터를 생성. DB만 비우고 시드를 안 하면 403 될 수 있음.

# 선택: mock 모드일 때 다른 고정 사용자로 세션 테스트 (예: 학부모 포털). 비우거나 testuser 와 동일하면 testuser 세션.
# AUTH_MOCK_USER_ID=parent-kim
# 플랫폼 `/platform/*` 확인 시 superadmin — `npm run seed` 로 기본·분원에 super_admin 멤버십이 생성되어 있어야 함.
# AUTH_MOCK_USER_ID=superadmin

# 초대 메일 (네이버 SMTP). 로컬·mock 기본은 미발송 — live 테스트 시 INVITE_MAIL_ENABLED=true
# INVITE_MAIL_ENABLED=false
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# INVITE_MAIL_FROM=
# INVITE_MAIL_FROM_NAME=학원 관리
# PUBLIC_APP_ORIGIN=http://localhost:5173

# 초대 SMS (스텁). live 테스트 시 INVITE_SMS_ENABLED=true — 실 API는 docs/개발자가-처리할-항목.md §7
# INVITE_SMS_ENABLED=false
# INVITE_SMS_PROVIDER=stub
# INVITE_SMS_API_KEY=
# INVITE_SMS_SENDER=

# 학부모 납부 안내 SMS (스텁). `/payments` 미납 「SMS」 — /p/settings SMS 동의
# PARENT_NOTIFY_SMS_ENABLED=false

# 학부모 납부 안내 이메일. true + SMTP(초대 메일 env) 시 실발송, 없으면 스텁
# PARENT_NOTIFY_EMAIL_ENABLED=false

# 학부모 납부 안내 푸시 (스텁). /p/settings 푸시 동의·구독 ID(8자+)
# PARENT_NOTIFY_PUSH_ENABLED=false

# 오픈뱅킹 스텁(`src/lib/server/banking/open-banking-stub.ts`) — 실제 연동 전 개발용
# OPEN_BANKING_ENABLED=true
# OPEN_BANKING_CLIENT_ID=
